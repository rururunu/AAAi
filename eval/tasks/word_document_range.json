{
  "id": "word_document_range",
  "prompt": "Summarize the first part of my current Word document.",
  "skipUnlessOffice": "word",
  "script": [
    {
      "content": "",
      "tool_calls": [
        {
          "name": "word_get_document_paragraphs",
          "arguments": {
            "paragraph_start": 1,
            "paragraph_count": 3,
            "max_chars": 4000
          }
        }
      ]
    },
    {
      "content": "Here is a summary based on the first paragraphs of the Word document.",
      "tool_calls": []
    }
  ],
  "assertions": [
    { "type": "toolCalled", "name": "word_get_document_paragraphs" },
    { "type": "answerContains", "text": "summary" }
  ]
}
