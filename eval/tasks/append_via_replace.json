{
  "id": "append_via_replace",
  "prompt": "Append line two to log.txt.",
  "setupFiles": [
    {
      "path": "log.txt",
      "content": "one\n"
    }
  ],
  "script": [
    {
      "content": "",
      "tool_calls": [
        {
          "name": "replace_in_file",
          "arguments": {
            "path": "log.txt",
            "old_string": "one\n",
            "new_string": "one\ntwo\n"
          }
        }
      ]
    },
    {
      "content": "",
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "log.txt"
          }
        }
      ]
    },
    {
      "content": "任务完成",
      "tool_calls": []
    }
  ],
  "assertions": [
    {
      "type": "fileContains",
      "path": "log.txt",
      "text": "two"
    }
  ]
}
